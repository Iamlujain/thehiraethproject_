---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { readTime?: string };
const { title, description, pubDate, updatedDate, heroImage, readTime } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
    margin: 0 0 0.5em 0;
    color: #eb7d00 !important; 
}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.read-time {
	text-align: center;
	font-style: italic;
	font-size: 0.9em;
	color: rgb(var(--gray));
	margin: 0.5rem 0 1.5rem 0; 
	font-family: 'Spectral', serif;
}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="title">
						
							<h1>{title}</h1>
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							{readTime && (
								<p class="read-time">✦ {readTime}</p>
							)}
							<hr />
						</div>
					</div>
						<slot />
				</div>
			</article>
		</main>
		<Footer />
		<script>
			const triggers = document.querySelectorAll('.lyric-trigger');
			const sidebar = document.getElementById('lyrics-panel');
			const closeBtn = document.getElementById('close-sidebar');
			const toggleBtn = document.getElementById('toggle-sidebar');
			const songSections = document.querySelectorAll<HTMLElement>('.song-section');
		  
			if (sidebar) {
			  
			  // The Reset Function: strips the highlight class from all lines
			  const clearHighlights = () => {
				document.querySelectorAll('.lyric-line').forEach(line => {
				  line.classList.remove('highlighted');
				});
			  };
		  
			  // 1. Listen for clicks on your essay text
			  triggers.forEach(trigger => {
				trigger.addEventListener('click', () => {
				  sidebar.classList.add('open');
				  clearHighlights(); // Clears any old highlights first
		  
				  // Grab both attributes from the clicked text
				  const targetSong = trigger.getAttribute('data-song');
				  const targetVerse = trigger.getAttribute('data-verse');
				  
				  // Hide all songs, show ONLY the one they are reading about
				  if (targetSong) {
					songSections.forEach(section => {
					  if (section.id === targetSong) {
						section.style.display = 'block';
					  } else {
						section.style.display = 'none';
					  }
					});
				  }
		  
				  // Find the verse and scroll to it
				  if (targetVerse) {
					const lyricLine = document.getElementById(targetVerse);
					
					if (lyricLine) {
					  lyricLine.classList.add('highlighted');
					  
					  // 150ms delay lets the sidebar open and the song block render before scrolling
					  setTimeout(() => {
						lyricLine.scrollIntoView({ behavior: 'smooth', block: 'center' });
					  }, 150);
					}
				  }
				});
			  });
		  
			  // 2. Listen for the Pull Tab (Manual open/close)
			  if (toggleBtn) {
				toggleBtn.addEventListener('click', () => {
				  sidebar.classList.toggle('open');
				  
				  // If the sidebar was just closed by clicking the tab, reset the text
				  if (!sidebar.classList.contains('open')) {
					setTimeout(clearHighlights, 400); /* Waits for the slide animation */
				  }
				});
			  }
		  
			  // 3. Listen for the X Close Button
			  if (closeBtn) {
				closeBtn.addEventListener('click', () => {
				  sidebar.classList.remove('open');
				  setTimeout(clearHighlights, 400); /* Waits for the slide animation */
				});
			  }
			}
		  </script>
	</body>
</html>
