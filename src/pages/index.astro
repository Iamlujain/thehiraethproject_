---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { Image } from 'astro:assets';
import TagCloud from '../components/TagCloud.astro';
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
            /* 1. Grid & Layout */
main {
    width: 100%;
    max-width: 960px;
    box-sizing: border-box;
    margin: 0 auto;
}

            ul {
                display: flex;
                flex-wrap: wrap;
                gap: 2rem;
                list-style-type: none;
                margin: 0;
                padding: 0;
            }
            ul li {
                width: calc(50% - 1rem);
                padding-bottom: 1rem;
                transition: all 0.2s ease;
            }
            ul li * {
                text-decoration: none;
                transition: 0.2s ease;
            }
            
            /* 2. Hero (First) Card Layout */
            ul li:first-child {
                width: 100%;
                margin-bottom: 1rem;
                text-align: center;
            }
            ul li:first-child img {
                width: 100%;
            }
            ul li:first-child .title {
                font-size: 2.369rem;
            }
            
            /* 3. Image & Link Resets */
            ul li img {
                width: 100%;
                aspect-ratio: 16 / 9; 
                object-fit: cover; 
                border-radius: 4px; 
                margin-bottom: 1rem;
                box-shadow: 0 4px 12px rgba(46, 41, 16, 0.1); 
            }
            ul li a {
                display: block;
                text-decoration: none !important; 
                border: none !important;
            }
          /* 4. Typography Spacing (Primary Resting Colors) */
		  .title {
                margin: 0 0 0.2rem 0;
                color: #5C4434; /* The vintage brown is back on the title */
                line-height: 1.2;
            }
            .date {
                margin: 0;
                color: #6A7B58; /* The muted sage/olive green */
                font-size: 0.85em;
            }
            .description {
                margin: 0.5rem 0 0.8rem 0; 
                font-size: 0.9em;
                line-height: 1.4;
                color: #6A7B58; /* The muted sage/olive green */
            }
            
            /* 5. Master Hover States (Controls the whole card) */
            ul li:hover {
                border-bottom: 1px solid #3A2A20; /* Dark brown line at the bottom */
            }
            ul li:hover h4.title {
                color: #3A2A20; /* Deepens the title's brown on hover */
                transform: translateY(-3px); 
            }
            ul li:hover .date,
            ul li:hover .description {
                color: #48563A; /* Deepens the date/desc green on hover */
            }
            ul li:hover img {
                box-shadow: var(--box-shadow);
            }
            /* 6. Tags */
            .post-tags {
                display: flex;
                gap: 1rem; 
                margin-top: 0.5rem;
                flex-wrap: wrap;
                justify-content: center; 
            } /* <-- The missing bracket is fixed here! */
            
            .tag {
                font-size: 0.65em; 
                text-transform: uppercase;
                letter-spacing: 0.1em;
                color: var(--sidebar-bg); 
                font-weight: 700;
                font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
                transition: color 0.2s ease;
                cursor: pointer; 
            }
            .tag:hover {
                color: var(--text-main); 
            }


            /* MOBILE VIEW */

            @media (max-width: 720px) {
    ul {
      gap: 0.5em;
      padding: 0; /* Kills the sneaky browser indent */
      margin: 0;
    }
    ul li {
      width: 100%;
      text-align: center;
      box-sizing: border-box; /* Forces it to perfectly fit inside the screen */
    }
    ul li:first-child {
      margin-bottom: 0;
    }
    ul li:first-child .title {
      font-size: 1.563em;
    }
    ul li img {
      width: 100% !important;
      height: auto !important; 
      aspect-ratio: 16 / 9 !important;
      object-fit: cover !important;
    
    }
  }
        </style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
						<li>
	<a href={`/blog/${post.id}/`}>
    <img width={720} height={360} src={post.data.heroImage} alt="" />
    <h4 class="title">{post.data.title}</h4>
    <p class="date">
        <FormattedDate date={post.data.pubDate} />
    </p>
    <p class="description">{post.data.description}</p>
</a>
	
{post.data.tags && (
        <div class="post-tags">
            {post.data.tags.map((tag) => (
                <a href={`/tag/${tag}`} class="tag">{tag}</a>
            ))}
        </div>
    )}
</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
